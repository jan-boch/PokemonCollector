# Supabase project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Your app's public URL (used for Google login redirects)
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth credentials for LOCAL Supabase auth
#SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
#SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-client-secret

# Optional: only needed for server-side privileged operations
#SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
